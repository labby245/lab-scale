diff --git a/src/realesrgan.cpp b/src/realesrgan.cpp
index 259886e..13f49a9 100644
--- a/src/realesrgan.cpp
+++ b/src/realesrgan.cpp
@@ -2,6 +2,9 @@
 
 #include "realesrgan.h"
 
+#include <cstdio>
+#include <cstring>
+
 #include <algorithm>
 #include <vector>
 
@@ -43,6 +46,34 @@ static const uint32_t realesrgan_postproc_tta_int8s_spv_data[] = {
     #include "realesrgan_postproc_tta_int8s.spv.hex.h"
 };
 
+// LabScale: models whose sampling grid is computed in-graph (GridSample, e.g. the
+// DySample upsampler of RealPLKSR) drift visibly when the grid is stored as fp16, so
+// such models run in fp32. Every other model keeps the fp16 path and its speed.
+static bool param_needs_fp32(FILE* fp)
+{
+    if (!fp)
+        return false;
+    bool found = false;
+    char line[4096];
+    while (fgets(line, sizeof(line), fp))
+    {
+        if (strncmp(line, "GridSample", 10) == 0)
+        {
+            found = true;
+            break;
+        }
+    }
+    rewind(fp);
+    return found;
+}
+
+static void use_fp32_storage(ncnn::Net& net)
+{
+    net.opt.use_fp16_packed = false;
+    net.opt.use_fp16_storage = false;
+    net.opt.use_int8_storage = false;
+}
+
 RealESRGAN::RealESRGAN(int gpuid, bool _tta_mode)
 {
     net.opt.use_vulkan_compute = true;
@@ -94,6 +125,9 @@ int RealESRGAN::load(const std::string& parampath, const std::string& modelpath)
             fwprintf(stderr, L"_wfopen %ls failed\n", parampath.c_str());
         }
 
+        if (param_needs_fp32(fp))
+            use_fp32_storage(net);
+
         net.load_param(fp);
 
         fclose(fp);
@@ -110,6 +144,13 @@ int RealESRGAN::load(const std::string& parampath, const std::string& modelpath)
         fclose(fp);
     }
 #else
+    {
+        FILE* fp = fopen(parampath.c_str(), "rb");
+        if (param_needs_fp32(fp))
+            use_fp32_storage(net);
+        if (fp)
+            fclose(fp);
+    }
     net.load_param(parampath.c_str());
     net.load_model(modelpath.c_str());
 #endif
